---
import { getCollection } from 'astro:content';

const existing = new Set((await getCollection('docs', ({ data }) => !data.draft)).map(({ id }) =>
  id === 'index' ? '' : id,
));
const locale = Astro.locals.starlightRoute.locale ?? 'root';
const currentId = Astro.locals.starlightRoute.id;
const relativeSlug = locale === 'root'
  ? currentId
  : currentId === locale ? '' : currentId.slice(locale.length + 1);
const languages = [
  { code: 'root', prefix: '', label: 'Српски', lang: 'sr' },
  { code: 'ru', prefix: 'ru', label: 'Русский', lang: 'ru' },
  { code: 'en', prefix: 'en', label: 'English', lang: 'en' },
].map(({ code, prefix, label, lang }) => {
  const targetId = [prefix, relativeSlug].filter(Boolean).join('/');
  const translated = existing.has(targetId);
  const href = '/' + (translated ? targetId : prefix);
  return { code, label, lang, translated, href: href === '/' ? href : href + '/' };
});
const ariaLabel = locale === 'ru' ? 'Выбор языка' : locale === 'en' ? 'Choose language' : 'Избор језика';
---

<nav class="locale-links" aria-label={ariaLabel}>
  {languages.map((lang) => (
    <a
      href={lang.href}
      lang={lang.lang}
      hreflang={lang.lang}
      aria-current={lang.code === locale ? 'page' : undefined}
      title={!lang.translated
        ? locale === 'ru' ? 'Перевода нет — перейти на главную' : locale === 'en'
          ? 'No translation — go to the home page' : 'Нема превода — пређи на почетну'
        : undefined}
    >{lang.label}</a>
  ))}
</nav>

<style>
  .locale-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem;
    font-size: var(--sl-text-xs);
  }
  .locale-links a {
    color: var(--sl-color-gray-2);
    border: 1px solid transparent;
    padding: 0.35rem 0.45rem;
    border-radius: 0.4rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .locale-links a:hover,
  .locale-links a:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }
  .locale-links a[aria-current='page'] {
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-gray-4);
    font-weight: 600;
  }
</style>
