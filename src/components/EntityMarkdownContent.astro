---
import DefaultMarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
import EntitySections from './EntitySections.astro';
const route = Astro.locals.starlightRoute;
const showSections = Boolean(route.entry.data.entityId && ['person','event','place'].includes(route.entry.data.entity));
---
<DefaultMarkdownContent>
  <slot />
  {showSections && <EntitySections />}
</DefaultMarkdownContent>
